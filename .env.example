# Local SQLite database. scripts/reset_db.py deletes only this file.
DATABASE_URL=sqlite:///./data/borrowed_intimacy.db

# Optional. Crawl jobs are stored without calling Firecrawl until a scraper is plugged in.
FIRECRAWL_API_KEY=

# Shared project settings. This API slice does not connect to Redis or an LLM.
REDIS_URL=redis://localhost:6379/0
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30

# OSINT discovery (optional username → public URL suggestions)
OSINT_USE_FIXTURES=false
OSINT_DATABASE_URL=sqlite:///./data/osint_sources.db
SHERLOCK_SITE_TIMEOUT_SECONDS=10
SHERLOCK_PROCESS_TIMEOUT_SECONDS=45
MAIGRET_SITE_TIMEOUT_SECONDS=10
MAIGRET_PROCESS_TIMEOUT_SECONDS=60
MAIGRET_MAX_SITES=500
WHATS_MY_NAME_DATA_URL=https://raw.githubusercontent.com/WebBreacher/WhatsMyName/main/wmn-data.json
WHATS_MY_NAME_CACHE_TTL_SECONDS=86400
WHATS_MY_NAME_SITE_TIMEOUT_SECONDS=8
WHATS_MY_NAME_MAX_CONCURRENCY=20
SPIDERFOOT_BASE_URL=http://127.0.0.1:5001
SPIDERFOOT_JOB_TIMEOUT_SECONDS=120
SPIDERFOOT_MAX_RESULTS=250
