# Local SQLite database. scripts/reset_db.py deletes only this file.
DATABASE_URL=sqlite:///./data/borrowed_intimacy.db

# Optional. Crawl jobs are stored without calling Firecrawl until a scraper is plugged in.
FIRECRAWL_API_KEY=

# Exact public URLs approved for ingestion (comma-separated).
CRAWL_ALLOWED_URLS=https://example.com/about
# Hosts whose terms have been reviewed and accepted (comma-separated).
CRAWL_TERMS_ACCEPTED_HOSTS=example.com
CRAWL_REQUESTS_PER_MINUTE=10

# Shared project settings. This API slice does not connect to Redis or an LLM.
REDIS_URL=redis://localhost:6379/0
LLM_API_KEY=
