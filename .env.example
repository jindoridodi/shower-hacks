# Local SQLite database. scripts/reset_db.py deletes only this file.
DATABASE_URL=sqlite:///./data/borrowed_intimacy.db

# Exact public URLs approved for ingestion (comma-separated).
CRAWL_ALLOWED_URLS=https://example.com/about
# Hosts whose terms have been reviewed and accepted (comma-separated).
CRAWL_TERMS_ACCEPTED_HOSTS=example.com
CRAWL_REQUESTS_PER_MINUTE=10

# Shared project settings. This API slice does not connect to Redis or an LLM.
REDIS_URL=redis://localhost:6379/0
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30

# Instagram profile lookup through Apify. Keep the token in .env only.
APIFY_API_TOKEN=
APIFY_INSTAGRAM_ACTOR=apify~instagram-profile-scraper
APIFY_INSTAGRAM_TIMEOUT_SECONDS=90
# Set true only for deterministic local demos and tests.
INSTAGRAM_USE_FIXTURES=false

# OSINT discovery (optional username → public URL suggestions)
OSINT_USE_FIXTURES=false
OSINT_DATABASE_URL=sqlite:///./data/osint_sources.db
SHERLOCK_SITE_TIMEOUT_SECONDS=10
SHERLOCK_PROCESS_TIMEOUT_SECONDS=45
MAIGRET_SITE_TIMEOUT_SECONDS=10
MAIGRET_PROCESS_TIMEOUT_SECONDS=60
MAIGRET_MAX_SITES=500
WHATS_MY_NAME_DATA_URL=https://raw.githubusercontent.com/WebBreacher/WhatsMyName/main/wmn-data.json
WHATS_MY_NAME_CACHE_TTL_SECONDS=86400
WHATS_MY_NAME_SITE_TIMEOUT_SECONDS=8
WHATS_MY_NAME_MAX_CONCURRENCY=20
SPIDERFOOT_BASE_URL=http://127.0.0.1:5001
SPIDERFOOT_JOB_TIMEOUT_SECONDS=120
SPIDERFOOT_MAX_RESULTS=250

# Optional local CPU embedding search. Restart server after changing this flag.
# Install: pip install -e ".[embeddings]"
EMBEDDINGS_ENABLED=false
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_MODEL_REVISION=5c38ec7c405ec4b44b94cc5a9bb96e735b38267a
EMBEDDING_BATCH_SIZE=16
# Optional persistent model cache directory; default is Hugging Face's cache.
# EMBEDDING_CACHE_DIR=./data/model-cache
